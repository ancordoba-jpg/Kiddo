import { createClient } from "npm:@supabase/supabase-js@2";

const url = Deno.env.get("SUPABASE_URL")!;
const serviceKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
const anonKey = Deno.env.get("SUPABASE_ANON_KEY")!;

const admin = createClient(url, serviceKey, {
  auth: { persistSession: false }
});

const mensaje = "Usuario o contraseña incorrectos.";

function respuesta(
  data: Record<string, unknown>,
  status: number,
  origin: string
) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": origin,
      "Access-Control-Allow-Headers":
        "authorization, x-client-info, apikey, content-type",
      "Access-Control-Allow-Methods": "POST, OPTIONS",
      "Vary": "Origin",
      "Cache-Control": "no-store"
    }
  });
}

Deno.serve(async (req) => {
  const origin = req.headers.get("origin") || "";

  // Durante las pruebas, solamente aceptar Kiddo local.
  const permitido =
    /^http:\/\/localhost:8765$/.test(origin) ||
    /^http:\/\/127\.0\.0\.1:8765$/.test(origin);

  const corsOrigin = permitido ? origin : "";

  if (!permitido) {
    return new Response("Origen no permitido", { status: 403 });
  }

  if (req.method === "OPTIONS") {
    return respuesta({}, 200, corsOrigin);
  }

  if (req.method !== "POST") {
    return respuesta({ error: "Metodo no permitido" }, 405, corsOrigin);
  }

  try {
    const contentLength = Number(req.headers.get("content-length") || 0);

    if (contentLength > 4096) {
      return respuesta({ error: mensaje }, 400, corsOrigin);
    }

    const body = await req.json();

    const username = String(body.username || "").trim().toLowerCase();
    const password = body.password;

    if (
      username.length < 6 ||
      username.length > 32 ||
      !/^[a-z0-9._!@#$%&*+=?-]+$/.test(username) ||
      typeof password !== "string" ||
      password.length < 1 ||
      password.length > 1024
    ) {
      return respuesta({ error: mensaje }, 401, corsOrigin);
    }

    const { data: profile, error: profileError } = await admin
      .from("kiddo_profiles")
      .select("user_id")
      .ilike("username", username)
      .maybeSingle();

    if (profileError || !profile) {
      return respuesta({ error: mensaje }, 401, corsOrigin);
    }

    const { data: userData, error: userError } =
      await admin.auth.admin.getUserById(profile.user_id);

    const email = userData?.user?.email;

    if (userError || !email) {
      return respuesta({ error: mensaje }, 401, corsOrigin);
    }

    // Supabase Auth verifica la contraseña real.
    const authResponse = await fetch(
      url + "/auth/v1/token?grant_type=password",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "apikey": anonKey
        },
        body: JSON.stringify({ email, password })
      }
    );

    if (!authResponse.ok) {
      return respuesta({ error: mensaje }, 401, corsOrigin);
    }

    const tokens = await authResponse.json();

    if (!tokens.access_token || !tokens.refresh_token) {
      return respuesta({ error: mensaje }, 401, corsOrigin);
    }

    return respuesta({
      access_token: tokens.access_token,
      refresh_token: tokens.refresh_token
    }, 200, corsOrigin);

  } catch (_) {
    return respuesta({ error: mensaje }, 401, corsOrigin);
  }
});