/* ======================================================
   KIDDO - MUSICA DESKTOP
   Ajuste para que TODO entre en pantalla sin scrollear
   ====================================================== */

@media screen and (min-width: 1024px) {

  /* Pantalla de musica */
  #screen-musica {
    display: flex !important;
    flex-direction: column !important;
    height: calc(100vh - 76px) !important;
    min-height: 0 !important;
    overflow: hidden !important;
  }

  /* Barra superior de subcategorias */
  #screen-musica .music-subtabs-nav {
    flex: 0 0 auto !important;
    margin-bottom: 10px !important;
  }

  /* Zona donde se pinta la escena */
  #screen-musica #music-tab-content {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: hidden !important;
    padding: 0 0 8px !important;
  }

  /* Escenario completo */
  #screen-musica .virtual-piano-experience {
    position: relative !important;
    display: block !important;
    flex: 0 0 auto !important;

    aspect-ratio: 1648 / 928 !important;

    /* entra completo en pantalla */
    height: min(66vh, calc(100vh - 185px)) !important;
    width: min(100%, calc((100vh - 185px) * 1648 / 928)) !important;
    max-width: 100% !important;

    margin: 0 auto !important;
    padding: 0 !important;

    background-image: url("../assets/music/fondo-crear-musica-desktop.png") !important;
    background-repeat: no-repeat !important;
    background-position: center center !important;
    background-size: 100% 100% !important;

    border: none !important;
    border-radius: 18px !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
  }

  /* Mensaje superior */
  #screen-musica .virtual-piano-experience .piano-banner {
    position: absolute !important;
    top: 1.5% !important;
    left: 50% !important;
    transform: translateX(-50%) scale(0.88) !important;
    transform-origin: top center !important;
    z-index: 20 !important;
    width: min(58%, 540px) !important;
    max-width: 90% !important;
  }

  /* Piano debajo de Puky y siempre visible */
  #screen-musica .virtual-piano-experience .piano-keyboard-wrapper {
    position: absolute !important;
    left: 50% !important;
    bottom: 2.2% !important;
    transform: translateX(-50%) !important;

    width: min(38%, 560px) !important;
    max-width: 90% !important;
    min-width: 0 !important;

    margin: 0 !important;
    padding: 8px 10px 12px !important;

    z-index: 25 !important;
    box-sizing: border-box !important;
  }

  /* Teclas del piano */
  #screen-musica .virtual-piano-experience .piano-keys-container {
    display: flex !important;
    flex-direction: row !important;
    gap: 6px !important;
    width: 100% !important;
  }

  #screen-musica .virtual-piano-experience .piano-key {
    flex: 1 1 0 !important;
    min-width: 0 !important;
    height: clamp(82px, 8.5vh, 118px) !important;
  }

  /* Efectos decorativos */
  #screen-musica .virtual-piano-experience .piano-notes-fx-layer {
    pointer-events: none !important;
  }
}
/* ====================================================
   AJUSTE DE TAMANO - CREAR MUSICA DESKTOP
   ==================================================== */

@media screen and (min-width: 1024px) {

  /* Ampliar escenario conservando proporcion */
  #screen-musica .virtual-piano-experience {
    height: min(76vh, calc(100vh - 175px)) !important;
    width: min(100%, calc((100vh - 175px) * 1648 / 928)) !important;
    max-width: 100% !important;
  }

  /* Piano ligeramente mas grande */
  #screen-musica .virtual-piano-experience .piano-keyboard-wrapper {
    width: min(43%, 620px) !important;
    bottom: 2% !important;
  }

  /* Teclas mas grandes */
  #screen-musica .virtual-piano-experience .piano-key {
    height: clamp(90px, 10vh, 135px) !important;
  }

}
