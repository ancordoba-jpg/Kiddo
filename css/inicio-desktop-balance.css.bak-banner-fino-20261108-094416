/* ================================================
   KIDDO - PUKY INICIO DESKTOP
   Proporciones y simetria corregidas
   ================================================ */

@media screen and (min-width: 1024px) {

  /* Mantener las dimensiones del escenario */
  #screen-inicio.active .puky-hero-card {
    position: relative !important;
    overflow: hidden !important;
  }

  /* Puky: agrandar la imagen real */
  #screen-inicio.active .hero-puky-img {
    display: block !important;

    width: clamp(400px, 28vw, 510px) !important;
    max-width: none !important;

    height: auto !important;
    max-height: min(70vh, 560px) !important;

    object-fit: contain !important;
    object-position: center bottom !important;

    transform-origin: center bottom !important;
  }

  /* Mantener a Puky cerca del suelo */
  #screen-inicio.active .hero-puky-wrapper {
    bottom: 8px !important;
    z-index: 3 !important;
  }

  /* Ambos globos: mismo tamaño */
  #screen-inicio.active .hero-bubble-left,
  #screen-inicio.active .hero-bubble-right {
    width: clamp(205px, 13.5vw, 270px) !important;
    max-width: 30% !important;

    height: auto !important;
    min-height: 0 !important;

    top: 23% !important;
    bottom: auto !important;

    z-index: 4 !important;
  }

  /* Globo izquierdo */
  #screen-inicio.active .hero-bubble-left {
    left: 9% !important;
    right: auto !important;
  }

  /* Globo derecho */
  #screen-inicio.active .hero-bubble-right {
    right: 9% !important;
    left: auto !important;
  }

  /* Ilustraciones de ambos globos */
  #screen-inicio.active .hero-bubble-left img,
  #screen-inicio.active .hero-bubble-right img {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    max-width: none !important;
    max-height: none !important;

    object-fit: contain !important;
  }

}


/* KIDDO BANNER COMPLETO V2 INICIO */

@media screen and (min-width: 1024px) {

  #screen-inicio.active .home-welcome-card {

    width: 100% !important;

    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;

    aspect-ratio: 2154 / 483 !important;

    background-image:
      url("../assets/home-redesign/banner-bienvenida-desktop.png") !important;

    background-size: 100% 100% !important;
    background-position: center center !important;
    background-repeat: no-repeat !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    box-sizing: border-box !important;
    overflow: hidden !important;
  }

  /* Texto centrado */
  #screen-inicio.active .welcome-content {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;

    width: 100% !important;
    padding: 10px 20px !important;

    text-align: center !important;
    position: relative !important;
    z-index: 2 !important;
  }

  /* Saludo principal */
  #screen-inicio.active .welcome-title {
    font-size: clamp(32px, 2.6vw, 46px) !important;
    line-height: 1.12 !important;
    font-weight: 800 !important;
    margin-bottom: 8px !important;
  }

  /* Texto inferior */
  #screen-inicio.active .welcome-subtitle {
    font-size: clamp(19px, 1.5vw, 25px) !important;
    line-height: 1.35 !important;
    font-weight: 700 !important;
  }

}

/* KIDDO BANNER COMPLETO V2 FIN */