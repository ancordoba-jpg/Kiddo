/* =======================================================
   KIDDO - CREAR MUSICA
   PROPORCIONES EXCLUSIVAS PARA COMPUTADORAS
   ======================================================= */

@media screen and (min-width: 1024px) {

  /* Escenario de Crear Musica */
  #screen-musica .virtual-piano-experience {
    position: relative !important;
    display: block !important;

    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    aspect-ratio: 1648 / 928;

    box-sizing: border-box !important;
    padding: 0 !important;
    margin: 0 auto !important;

    background-image: url("../assets/music/fondo-crear-musica-desktop.png") !important;
    background-position: center center !important;
    background-size: 100% 100% !important;
    background-repeat: no-repeat !important;

    overflow: hidden !important;
    border: none !important;
    border-radius: 16px !important;
  }

  /* Contenedor principal de musica */
  #screen-musica #music-tab-content {
    width: 100%;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
  }

  /* Piano sobre el piso, debajo de Puky */
  #screen-musica .virtual-piano-experience
  .piano-keyboard-wrapper {
    position: absolute !important;

    left: 50% !important;
    right: auto !important;
    top: auto !important;
    bottom: 6% !important;

    transform: translateX(-50%) !important;

    width: 62% !important;
    max-width: 660px !important;
    min-width: 0 !important;

    margin: 0 !important;
    box-sizing: border-box !important;

    z-index: 20 !important;
  }

  /* Mantener las 8 teclas correctamente distribuidas */
  #screen-musica .virtual-piano-experience
  .piano-keys-container {
    display: flex !important;
    width: 100% !important;
    gap: 6px !important;
  }

  #screen-musica .virtual-piano-experience
  .piano-key {
    flex: 1 1 0 !important;
    min-width: 0 !important;
    height: clamp(85px, 10vw, 125px) !important;
  }

  /* Las notas animadas no bloquean el piano */
  #screen-musica .virtual-piano-experience
  .piano-notes-fx-layer {
    pointer-events: none !important;
  }

}