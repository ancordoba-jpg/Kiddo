/* ======================================================
   KIDDO - CREAR MUSICA DESKTOP
   Imagen completa + piano debajo de Puky
   Solo computadoras
   ====================================================== */

@media screen and (min-width: 1024px) {

  /* Mantener la navegacion original */
  #screen-musica {
    min-width: 0;
  }

  /* Permitir recorrer toda la escena sin recortarla */
  #screen-musica #music-tab-content {
    display: block !important;
    width: 100% !important;
    min-height: 0 !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
  }

  /* Escenario completo con la proporcion de la imagen */
  #screen-musica .virtual-piano-experience {
    display: block !important;
    position: relative !important;
    flex: none !important;

    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;

    aspect-ratio: 1800 / 950 !important;

    padding: 0 !important;
    margin: 0 auto !important;

    background-image: url("../assets/music/fondo-crear-musica-desktop.png") !important;
    background-position: center center !important;
    background-size: 100% 100% !important;
    background-repeat: no-repeat !important;

    border-radius: 16px !important;
    border: none !important;

    box-sizing: border-box !important;
    overflow: hidden !important;
  }

  /* Piano centrado sobre el piso, debajo de Puky */
  #screen-musica .virtual-piano-experience
  .piano-keyboard-wrapper {
    position: absolute !important;

    left: 50% !important;
    right: auto !important;

    top: auto !important;
    bottom: 4% !important;

    transform: translateX(-50%) !important;

    width: 100% !important;
    max-width: 720px !important;
    min-width: 0 !important;

    padding: 8px 10px 12px !important;
    margin: 0 !important;

    z-index: 20 !important;
    box-sizing: border-box !important;
  }

  /* Mantener las ocho teclas horizontales */
  #screen-musica .virtual-piano-experience
  .piano-keys-container {
    display: flex !important;
    flex-direction: row !important;
    width: 100% !important;
    gap: 6px !important;
  }

  #screen-musica .virtual-piano-experience
  .piano-key {
    flex: 1 1 0 !important;
    min-width: 0 !important;
    height: clamp(95px, 10vw, 145px) !important;
  }

  /* Mensaje superior */
  #screen-musica .virtual-piano-experience
  .piano-banner {
    position: absolute !important;
    top: 2% !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 15 !important;
  }

  /* Efectos musicales: no bloquear las teclas */
  #screen-musica .virtual-piano-experience
  .piano-notes-fx-layer {
    pointer-events: none !important;
  }

}
/* ===================================================
   KIDDO - PIANO MAS ALTO
   Ocupa el espacio entre Puky y el teclado
   SOLO COMPUTADORAS
   =================================================== */

@media screen and (min-width: 1024px) {

  /* Aumentar altura de las teclas hacia arriba */
  #screen-musica .virtual-piano-experience .piano-key {
    height: clamp(220px, 29vh, 310px) !important;
  }

  /* Mantener el piano en su posicion inferior */
  #screen-musica .virtual-piano-experience .piano-keyboard-wrapper {
    bottom: 1.5% !important;
  }

  /* Nombres de las notas mas visibles */
  #screen-musica .virtual-piano-experience .key-note-name {
    font-size: 20px !important;
    font-weight: 800 !important;
  }

  /* Nota DO agudo */
  #screen-musica .virtual-piano-experience
  .piano-key.key-c-high .key-note-name {
    font-size: 18px !important;
  }

}

/* ==========================================
   CARTEL SUPERIOR DE CREAR MUSICA - DESKTOP
   ========================================== */

@media screen and (min-width: 1024px) {

  /* Cartel casi de lado a lado */
  #screen-musica .virtual-piano-experience .piano-banner {
    position: absolute !important;
    top: 2% !important;
    left: 50% !important;
    right: auto !important;

    width: 94% !important;
    max-width: none !important;
    box-sizing: border-box !important;

    transform: translateX(-50%) !important;
    z-index: 30 !important;
  }

  /* Texto mas grande */
  #screen-musica .virtual-piano-experience .piano-banner-text {
    font-size: 22px !important;
    line-height: 1.35 !important;
    font-weight: 800 !important;
    text-align: center !important;
  }

  /* Koala del cartel un poco mas grande */
  #screen-musica .virtual-piano-experience .piano-banner-avatar {
    font-size: 30px !important;
    flex-shrink: 0 !important;
  }

}

/* ====================================================
   KIDDO - CARTEL DE MUSICA DE PUNTA A PUNTA
   SOLO COMPUTADORAS
   ==================================================== */

@media screen and (min-width: 1024px) {

  /* Cartel superior a todo el ancho del fondo */
  #screen-musica .virtual-piano-experience .piano-banner,
  #screen-musica .virtual-piano-experience
  :has(> .piano-banner-text) {

    position: absolute !important;

    top: 0 !important;
    left: 0 !important;
    right: 0 !important;

    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;

    transform: none !important;
    margin: 0 !important;

    padding: 15px 24px !important;

    box-sizing: border-box !important;
    border-radius: 16px 16px 0 0 !important;

    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 16px !important;

    z-index: 30 !important;
  }

  /* Mensaje mas grande y centrado */
  #screen-musica .virtual-piano-experience .piano-banner-text {
    font-size: 23px !important;
    line-height: 1.3 !important;
    font-weight: 800 !important;
    text-align: center !important;

    width: auto !important;
    max-width: none !important;
    flex: 0 1 auto !important;
    white-space: normal !important;
  }

  /* Icono de Puky */
  #screen-musica .virtual-piano-experience .piano-banner-avatar {
    font-size: 32px !important;
    flex-shrink: 0 !important;
  }

}

/* ===================================================
   KIDDO - CORRECCION ESPACIO BLANCO INFERIOR
   SOLO COMPUTADORAS
   =================================================== */

@media screen and (min-width: 1024px) {

  /* Toda la pantalla de musica */
  #screen-musica {
    display: flex !important;
    flex-direction: column !important;
    height: calc(100dvh - 76px) !important;
    min-height: 0 !important;
    overflow: hidden !important;
  }

  /* Barra de categorias */
  #screen-musica .music-subtabs-nav {
    flex: 0 0 auto !important;
    margin-bottom: 8px !important;
  }

  /* El contenido ocupa todo el espacio disponible */
  #screen-musica #music-tab-content {
    display: flex !important;
    flex-direction: column !important;
    flex: 1 1 auto !important;
    height: auto !important;
    min-height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    overflow: hidden !important;
  }

  /* Fondo hasta el borde inferior */
  #screen-musica .virtual-piano-experience {
    position: relative !important;
    display: block !important;
    flex: 1 1 auto !important;

    width: 100% !important;
    max-width: none !important;
    height: 100% !important;
    min-height: 0 !important;

    aspect-ratio: auto !important;

    background-image: url("../assets/music/fondo-crear-musica-desktop.png") !important;
    background-size: 100% 100% !important;
    background-position: center !important;
    background-repeat: no-repeat !important;

    margin: 0 !important;
    padding: 0 !important;
    border-radius: 16px !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
  }

  /* Piano completamente visible */
  #screen-musica .virtual-piano-experience
  .piano-keyboard-wrapper {
    position: absolute !important;
    top: auto !important;
    bottom: 2% !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    margin: 0 !important;
    z-index: 25 !important;
  }

  /* Teclas altas, pero adaptadas a la pantalla */
  #screen-musica .virtual-piano-experience .piano-key {
    height: clamp(150px, 25dvh, 240px) !important;
  }

}
