/* KIDDO - NUEVO PANEL PARENTAL RESPONSIVE */

/* Cabecera ilustrada */
.kiddo-parent-hero-new {
    position: relative !important;
    isolation: isolate;
    box-sizing: border-box;
    width: 100%;
    min-height: 185px;
    padding: 22px 30px !important;
    border-radius: 30px !important;
    overflow: hidden !important;

    background-color: #2057a9 !important;
    background-image:
        linear-gradient(90deg,
          rgba(12,39,100,.28),
          rgba(12,39,100,0) 75%),
        url("../assets/parental/banner-control-parental.png") !important;
    background-size: cover !important;
    background-position: center center !important;
    background-repeat: no-repeat !important;

    color: #fff !important;
    box-shadow: 0 10px 24px rgba(37,79,148,.12);
}

.kiddo-parent-hero-new h1,
.kiddo-parent-hero-new h2,
.kiddo-parent-hero-new .parent-dash-title-wrap h2 {
    color: white !important;
    font-size: clamp(23px, 2.2vw, 35px) !important;
    line-height: 1.2 !important;
}

.kiddo-parent-hero-new .parent-dash-title-wrap p {
    color: #f0f6ff !important;
}

/* Tarjetas principales */
.kiddo-parent-card-time,
.kiddo-parent-card-schedule {
    position: relative !important;
    isolation: isolate;
    box-sizing: border-box;
    overflow: hidden !important;
    border-radius: 26px !important;
    background-color: #fff !important;
    box-shadow: 0 7px 22px rgba(46,75,115,.08) !important;
}

/* Ilustraciones decorativas */
.kiddo-parent-card-time::after,
.kiddo-parent-card-schedule::after {
    content: "";
    position: absolute;
    right: 16px;
    bottom: 10px;
    width: min(24%, 300px);
    height: 165px;
    background-repeat: no-repeat;
    background-size: contain;
    background-position: right bottom;
    pointer-events: none;
    mix-blend-mode: multiply;
    z-index: 0;
}

.kiddo-parent-card-time::after {
    background-image:
      url("../assets/parental/puky-tiempo-pantalla.png");
}

.kiddo-parent-card-schedule::after {
    background-image:
      url("../assets/parental/puky-horario-permitido.png");
}

/* Mantener los controles por encima de las ilustraciones */
.kiddo-parent-card-time > *,
.kiddo-parent-card-schedule > * {
    position: relative;
    z-index: 1;
}

/* Estadisticas con colores suaves */
.kiddo-parent-card-time .time-stat-pill {
    border-radius: 21px !important;
    padding: 12px !important;
}

/* TABLETS */
@media (min-width: 600px) and (max-width: 1023px) {

    .kiddo-parent-hero-new {
        min-height: 170px;
        padding: 20px !important;
        border-radius: 24px !important;
    }

    .kiddo-parent-card-time::after,
    .kiddo-parent-card-schedule::after {
        width: 24%;
        height: 125px;
        opacity: .85;
    }
}

/* CELULARES */
@media (max-width: 599px) {

    .kiddo-parent-hero-new {
        min-height: 215px;
        padding: 18px !important;
        border-radius: 22px !important;
        background-position: 58% center !important;
        background-image:
          linear-gradient(
            90deg,
            rgba(13,43,107,.74),
            rgba(13,43,107,.25)
          ),
          url("../assets/parental/banner-control-parental.png") !important;
    }

    .kiddo-parent-hero-new h1,
    .kiddo-parent-hero-new h2 {
        font-size: 23px !important;
    }

    .kiddo-parent-card-time,
    .kiddo-parent-card-schedule {
        border-radius: 20px !important;
    }

    .kiddo-parent-card-time::after,
    .kiddo-parent-card-schedule::after {
        width: 105px;
        height: 90px;
        right: 5px;
        top: 10px;
        bottom: auto;
        opacity: .28;
    }
}

@media (prefers-reduced-motion: reduce) {
    .kiddo-parent-hero-new,
    .kiddo-parent-card-time,
    .kiddo-parent-card-schedule {
        animation: none !important;
        transition: none !important;
    }
}