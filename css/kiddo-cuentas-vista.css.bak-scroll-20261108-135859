/* KIDDO - FORMULARIOS DE CUENTAS RESPONSIVE */

#screen-login .kiddo-cuentas-card {
    width: min(100% - 32px, 500px) !important;
    max-width: 500px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    position: relative;
    z-index: 5;
}

.kiddo-cuentas-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
}

.kiddo-cuentas-tab {
    flex: 1;
    border: 1px solid #d8e7f5;
    border-radius: 18px;
    padding: 12px 8px;
    background: #f5f8ff;
    color: #71819b;
    font-weight: 700;
    cursor: pointer;
}

.kiddo-cuentas-tab.active {
    background: #dff2ff;
    color: #0284c7;
    border-color: #b1defb;
}

.kiddo-cuentas-form {
    display: flex;
    flex-direction: column;
    gap: 9px;
}

.kiddo-cuentas-form[hidden] {
    display: none !important;
}

.kiddo-cuentas-form label {
    font-size: 13px;
    font-weight: 700;
    color: #45536c;
}

.kiddo-cuentas-form input,
.kiddo-cuentas-form select {
    display: block;
    width: 100%;
    min-height: 47px;
    border: 1px solid #d4e3f3;
    border-radius: 20px;
    padding: 10px 16px;
    background: #fff;
    color: #334155;
    box-sizing: border-box;
    font: inherit;
}

.kiddo-cuentas-form small,
.kiddo-cuentas-help,
.kiddo-cuentas-status {
    font-size: 12px;
    color: #71819b;
    line-height: 1.4;
}

.kiddo-cuentas-primary {
    width: 100%;
    min-height: 50px;
    margin-top: 9px;
    background: #4aa8f5;
    color: white;
    border: none;
    border-radius: 24px;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
}

.kiddo-cuentas-status {
    margin-top: 12px;
    text-align: center;
}

@media screen and (min-width: 1024px) {
    #screen-login .kiddo-cuentas-card {
        width: 500px !important;
    }
}

@media screen and (max-width: 1023px) {
    #screen-login .kiddo-cuentas-card {
        width: min(92vw, 440px) !important;
    }
}

@media screen and (max-width: 599px) {
    #screen-login .kiddo-cuentas-card {
        width: min(92vw, 360px) !important;
    }

    .kiddo-cuentas-form input,
    .kiddo-cuentas-form select {
        min-height: 43px;
    }
}