/* =========================================================
   KIDDO - AJUSTES DESKTOP
   Banner mas bajo + tarjetas mas grandes + textos mayores
   ========================================================= */

@media screen and (min-width: 1024px) {

  /* ===== BANNER ===== */
  #screen-ajustes .kiddo-banner-ajustes-responsive,
  #screen-ajustes .settings-banner,
  #screen-ajustes .settings-banner-wrapper,
  #screen-ajustes .settings-hero-banner {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    margin-bottom: 22px !important;
  }

  #screen-ajustes img.settings-banner-img,
  #screen-ajustes .kiddo-banner-ajustes-responsive img,
  #screen-ajustes .settings-banner img,
  #screen-ajustes .settings-banner-wrapper img,
  #screen-ajustes .settings-hero-banner img {
    display: block !important;
    width: 100% !important;
    height: 360px !important;          /* mas chico verticalmente */
    min-height: 0 !important;
    max-height: 360px !important;
    object-fit: cover !important;
    object-position: center center !important;
    border-radius: 28px !important;
  }

  /* ===== CONTENEDOR GENERAL DE TARJETAS ===== */
  #screen-ajustes .settings-content,
  #screen-ajustes .settings-sections,
  #screen-ajustes .settings-list,
  #screen-ajustes .settings-grid,
  #screen-ajustes .settings-options {
    gap: 18px !important;
  }

  /* ===== TARJETAS / BLOQUES DE ABAJO ===== */
  #screen-ajustes .settings-card,
  #screen-ajustes .setting-card,
  #screen-ajustes .settings-option-card,
  #screen-ajustes .settings-panel,
  #screen-ajustes .settings-item,
  #screen-ajustes .parental-control-card,
  #screen-ajustes .adult-mode-card,
  #screen-ajustes .config-card,
  #screen-ajustes .card {
    min-height: 175px !important;      /* mas grandes */
    padding: 22px 24px !important;
    border-radius: 24px !important;
    box-sizing: border-box !important;
  }

  /* ===== TITULOS DE LAS TARJETAS ===== */
  #screen-ajustes .settings-card h2,
  #screen-ajustes .settings-card h3,
  #screen-ajustes .setting-card h2,
  #screen-ajustes .setting-card h3,
  #screen-ajustes .settings-option-card h2,
  #screen-ajustes .settings-option-card h3,
  #screen-ajustes .settings-panel h2,
  #screen-ajustes .settings-panel h3,
  #screen-ajustes .settings-item h2,
  #screen-ajustes .settings-item h3,
  #screen-ajustes .parental-control-card h2,
  #screen-ajustes .parental-control-card h3,
  #screen-ajustes .adult-mode-card h2,
  #screen-ajustes .adult-mode-card h3,
  #screen-ajustes .config-card h2,
  #screen-ajustes .config-card h3,
  #screen-ajustes .card h2,
  #screen-ajustes .card h3 {
    font-size: 1.9rem !important;
    line-height: 1.15 !important;
    margin-bottom: 10px !important;
  }

  /* ===== TEXTOS DESCRIPTIVOS ===== */
  #screen-ajustes .settings-card p,
  #screen-ajustes .setting-card p,
  #screen-ajustes .settings-option-card p,
  #screen-ajustes .settings-panel p,
  #screen-ajustes .settings-item p,
  #screen-ajustes .parental-control-card p,
  #screen-ajustes .adult-mode-card p,
  #screen-ajustes .config-card p,
  #screen-ajustes .card p,
  #screen-ajustes .settings-card span,
  #screen-ajustes .setting-card span,
  #screen-ajustes .settings-option-card span,
  #screen-ajustes .settings-panel span,
  #screen-ajustes .settings-item span,
  #screen-ajustes .parental-control-card span,
  #screen-ajustes .adult-mode-card span,
  #screen-ajustes .config-card span,
  #screen-ajustes .card span {
    font-size: 1.15rem !important;
    line-height: 1.45 !important;
  }

  /* ===== ETIQUETAS TIPO "EXCLUSIVO ADULTOS" ===== */
  #screen-ajustes .badge,
  #screen-ajustes .tag,
  #screen-ajustes .label,
  #screen-ajustes .chip {
    font-size: 0.95rem !important;
    padding: 8px 14px !important;
    border-radius: 999px !important;
  }

  /* ===== BOTONES ===== */
  #screen-ajustes button,
  #screen-ajustes .btn,
  #screen-ajustes .button,
  #screen-ajustes .settings-btn,
  #screen-ajustes .access-button,
  #screen-ajustes .parental-button {
    min-height: 54px !important;
    padding: 14px 24px !important;
    font-size: 1.12rem !important;
    border-radius: 999px !important;
  }

  /* ===== ICONOS LATERALES DENTRO DE LA TARJETA ===== */
  #screen-ajustes .settings-card img,
  #screen-ajustes .setting-card img,
  #screen-ajustes .settings-option-card img,
  #screen-ajustes .settings-panel img,
  #screen-ajustes .settings-item img,
  #screen-ajustes .parental-control-card img,
  #screen-ajustes .adult-mode-card img,
  #screen-ajustes .config-card img,
  #screen-ajustes .card img,
  #screen-ajustes .settings-card svg,
  #screen-ajustes .setting-card svg,
  #screen-ajustes .settings-option-card svg,
  #screen-ajustes .settings-panel svg,
  #screen-ajustes .settings-item svg,
  #screen-ajustes .parental-control-card svg,
  #screen-ajustes .adult-mode-card svg,
  #screen-ajustes .config-card svg,
  #screen-ajustes .card svg {
    max-width: 92px !important;
    max-height: 92px !important;
  }

}

/* KIDDO RESTAURAR BANNER NUEVO INICIO */

@media screen and (min-width: 1024px) {

    /* Mostrar nuevamente el banner nuevo de escritorio */
    #screen-ajustes.active img.settings-banner-img {

        content: url("../assets/ajustes/banner-ajustes-desktop.png") !important;

        display: block !important;

        width: 100% !important;
        height: 360px !important;

        min-height: 0 !important;
        max-height: 360px !important;
        max-width: 100% !important;

        object-fit: cover !important;
        object-position: center center !important;

        border-radius: 26px !important;
    }

}

/* KIDDO RESTAURAR BANNER NUEVO FIN */


/* KIDDO AJUSTE ANCHO BANNER AJUSTES INICIO */

@media screen and (min-width: 1024px) {

  #screen-ajustes.active .kiddo-banner-ajustes-responsive,
  #screen-ajustes.active .settings-banner-img {
    width: 94% !important;
    max-width: 94% !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

}

/* KIDDO AJUSTE ANCHO BANNER AJUSTES FIN */

/* KIDDO BANNER AJUSTES COMPACTO INICIO */

@media screen and (min-width: 1024px) {

  #screen-ajustes.active img.settings-banner-img {
    content: url("../assets/ajustes/banner-ajustes-desktop.png") !important;

    width: 100% !important;
    max-width: 100% !important;

    height: 280px !important;
    min-height: 0 !important;
    max-height: 280px !important;

    object-fit: cover !important;
    object-position: center center !important;

    margin: 0 !important;
    border-radius: 26px !important;
  }

  #screen-ajustes.active .kiddo-banner-ajustes-responsive {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto 16px !important;
  }

}

/* KIDDO BANNER AJUSTES COMPACTO FIN */