/* ==============================================
   KIDDO - BANNER AJUSTES DESKTOP
   Sustitucion visual sin cambiar el HTML
   ============================================== */

@media screen and (min-width: 1024px) {

    #screen-ajustes img.settings-banner-img,
    #screen-ajustes.active img.settings-banner-img {

        content: url("../assets/ajustes/banner-ajustes-desktop.png") !important;

        display: block !important;

        width: 100% !important;
        height: auto !important;

        max-width: 100% !important;
        max-height: none !important;

        object-fit: contain !important;

        border-radius: 26px !important;
    }

}