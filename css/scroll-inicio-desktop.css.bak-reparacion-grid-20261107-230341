/* ================================================
   KIDDO - SCROLL DE INICIO EN COMPUTADORAS
   Altura natural y desplazamiento con rueda
   ================================================ */

@media screen and (min-width: 1024px) {

  /* Contenedor principal desplazable */
  .app-content-viewport:has(> #screen-inicio.active) {
    flex: 1 1 auto !important;
    min-height: 0 !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;

    padding-bottom: 0 !important;
    margin-bottom: 0 !important;

    overscroll-behavior-y: auto !important;
    box-sizing: border-box !important;
  }

  /* Inicio ocupa la altura necesaria para sus contenidos */
  #screen-inicio.active {
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    align-items: stretch !important;

    height: max-content !important;
    min-height: 0 !important;
    max-height: none !important;

    overflow: visible !important;

    padding-bottom: 16px !important;
    margin-bottom: 0 !important;

    box-sizing: border-box !important;
  }

  /* Actividades recientes sin altura artificial */
  #screen-inicio.active .recent-activities-section {
    height: auto !important;
    min-height: 0 !important;
    flex: 0 0 auto !important;
  }

}