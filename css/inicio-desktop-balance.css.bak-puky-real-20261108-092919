/* =========================================================
   KIDDO - INICIO DESKTOP
   Mejora de Puky + diálogos en pantalla de Inicio
   Solo escritorio
   ========================================================= */

@media screen and (min-width: 1024px) {

  #screen-inicio .kiddo-home-hero {
    position: relative !important;
    overflow: hidden !important;
    min-height: 640px !important;
  }

  /* Puky más grande */
  #screen-inicio .kiddo-home-puky-wrap {
    position: absolute !important;
    left: 50% !important;
    bottom: 18px !important;
    transform: translateX(-50%) scale(1.28) !important;
    transform-origin: bottom center !important;
    z-index: 3 !important;
    width: 300px !important;
    max-width: 34% !important;
    pointer-events: none !important;
  }

  #screen-inicio .kiddo-home-puky {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    max-width: none !important;
  }

  /* Diálogos más grandes */
  #screen-inicio .kiddo-home-bubble-left,
  #screen-inicio .kiddo-home-bubble-right {
    position: absolute !important;
    z-index: 4 !important;
    max-width: 260px !important;
    width: 250px !important;
    min-height: 150px !important;
    transform: scale(1.18) !important;
    transform-origin: center center !important;
    text-align: center !important;
  }

  #screen-inicio .kiddo-home-bubble-left {
    left: 12% !important;
    top: 25% !important;
  }

  #screen-inicio .kiddo-home-bubble-right {
    right: 12% !important;
    top: 24% !important;
  }

  #screen-inicio .kiddo-home-bubble-left *,
  #screen-inicio .kiddo-home-bubble-right * {
    font-size: 1.08em !important;
    line-height: 1.12 !important;
  }
}