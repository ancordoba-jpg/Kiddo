/* =================================================
   KIDDO - INICIO ADAPTADO A ALTURA DE PANTALLA
   Solo escritorio
   ================================================= */

@media screen and (min-width: 1024px) {

  /* Usar toda la altura disponible del viewport */
  #app-viewport:has(> #screen-inicio.active) {
    min-height: 0 !important;
    padding-bottom: 0 !important;
    overflow-y: auto !important;
  }

  /* Mantener el grid original y aprovechar el alto */
  #app-viewport > #screen-inicio.active {
    display: grid !important;
    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(0, 0.9fr) !important;

    grid-template-rows:
      auto auto minmax(min-content, 1fr) !important;

    min-height: 100% !important;
    height: auto !important;
    max-height: none !important;

    align-content: stretch !important;
    align-items: stretch !important;

    box-sizing: border-box !important;
    padding-bottom: 16px !important;
    margin-bottom: 0 !important;

    overflow: visible !important;
  }

  /* Banner superior */
  #screen-inicio.active .home-welcome-card {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  /* Escenario Puky: eliminar limite de 370px */
  #screen-inicio.active .puky-hero-card {
    grid-column: 1;
    grid-row: 2 / 4;

    height: 100% !important;
    min-height: 370px !important;
    max-height: none !important;

    align-self: stretch !important;

    background-size: cover !important;
    background-position: center bottom !important;
  }

  /* Botones de acceso */
  #screen-inicio.active .categories-row-section {
    grid-column: 2;
    grid-row: 2;
    align-self: start !important;
  }

  /* Columna de actividades */
  #screen-inicio.active .recent-activities-section {
    grid-column: 2;
    grid-row: 3;

    display: flex !important;
    flex-direction: column !important;

    height: 100% !important;
    min-height: 0 !important;

    align-self: stretch !important;
  }

  /* Distribuir las actividades en la altura restante */
  #screen-inicio.active .recent-activities-list {
    display: flex !important;
    flex-direction: column !important;
    flex: 1 1 auto !important;

    justify-content: space-between !important;
    gap: 10px !important;
  }

  #screen-inicio.active .recent-activities-list > * {
    flex: 1 1 auto !important;
    display: flex;
    align-items: center;
  }

}