/* ======================================================
   KIDDO - CREAR MUSICA DESKTOP
   Imagen completa + piano debajo de Puky
   Solo computadoras
   ====================================================== */

@media screen and (min-width: 1024px) {

  /* Mantener la navegacion original */
  #screen-musica {
    min-width: 0;
  }

  /* Permitir recorrer toda la escena sin recortarla */
  #screen-musica #music-tab-content {
    display: block !important;
    width: 100% !important;
    min-height: 0 !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
  }

  /* Escenario completo con la proporcion de la imagen */
  #screen-musica .virtual-piano-experience {
    display: block !important;
    position: relative !important;
    flex: none !important;

    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;

    aspect-ratio: 1800 / 950 !important;

    padding: 0 !important;
    margin: 0 auto !important;

    background-image: url("../assets/music/fondo-crear-musica-desktop.png") !important;
    background-position: center center !important;
    background-size: 100% 100% !important;
    background-repeat: no-repeat !important;

    border-radius: 16px !important;
    border: none !important;

    box-sizing: border-box !important;
    overflow: hidden !important;
  }

  /* Piano centrado sobre el piso, debajo de Puky */
  #screen-musica .virtual-piano-experience
  .piano-keyboard-wrapper {
    position: absolute !important;

    left: 50% !important;
    right: auto !important;

    top: auto !important;
    bottom: 4% !important;

    transform: translateX(-50%) !important;

    width: 100% !important;
    max-width: 720px !important;
    min-width: 0 !important;

    padding: 8px 10px 12px !important;
    margin: 0 !important;

    z-index: 20 !important;
    box-sizing: border-box !important;
  }

  /* Mantener las ocho teclas horizontales */
  #screen-musica .virtual-piano-experience
  .piano-keys-container {
    display: flex !important;
    flex-direction: row !important;
    width: 100% !important;
    gap: 6px !important;
  }

  #screen-musica .virtual-piano-experience
  .piano-key {
    flex: 1 1 0 !important;
    min-width: 0 !important;
    height: clamp(95px, 10vw, 145px) !important;
  }

  /* Mensaje superior */
  #screen-musica .virtual-piano-experience
  .piano-banner {
    position: absolute !important;
    top: 2% !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 15 !important;
  }

  /* Efectos musicales: no bloquear las teclas */
  #screen-musica .virtual-piano-experience
  .piano-notes-fx-layer {
    pointer-events: none !important;
  }

}
/* ===================================================
   KIDDO - PIANO MAS ALTO
   Ocupa el espacio entre Puky y el teclado
   SOLO COMPUTADORAS
   =================================================== */

@media screen and (min-width: 1024px) {

