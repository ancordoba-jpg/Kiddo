/* ============================================
   KIDDO - ICONOS NUEVOS DE NAVEGACION
   Computadora, tablet y celular
   ============================================ */

.nav-tab-btn .nav-icon-box {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
}

.nav-tab-btn .nav-icon {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
}

.nav-tab-btn .kiddo-nav-icon-img {
    display: block !important;
    width: 27px !important;
    height: 27px !important;
    max-width: none !important;
    object-fit: contain !important;
}

/* TABLETS */
@media screen and (min-width: 600px) and (max-width: 1023px) {

    .nav-tab-btn .kiddo-nav-icon-img {
        width: 32px !important;
        height: 32px !important;
    }

}

/* COMPUTADORAS */
@media screen and (min-width: 1024px) {

    .nav-tab-btn .kiddo-nav-icon-img {
        width: 36px !important;
        height: 36px !important;
    }

    .nav-tab-btn .nav-icon-box {
        width: 42px !important;
        height: 42px !important;
        flex-shrink: 0 !important;
    }

}


/* KIDDO ICONOS DESKTOP +10 INICIO */

@media screen and (min-width: 1024px) {

    .nav-tab-btn .kiddo-nav-icon-img {
        width: 41.6px !important;
        height: 41.6px !important;
        object-fit: contain !important;
        object-position: center !important;
    }

    .nav-tab-btn .nav-icon-box {
        width: 46px !important;
        height: 46px !important;
        flex-shrink: 0 !important;
    }

}

/* KIDDO ICONOS DESKTOP +10 FIN */